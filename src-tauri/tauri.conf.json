{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AM Player",
  "version": "0.1.0",
  "identifier": "com.amplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AM Player",
        "width": 900,
        "height": 1600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 29
    }
  }
}
